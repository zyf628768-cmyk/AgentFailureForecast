{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-failure-forecast:plan:1",
  "type": "object",
  "properties": {
    "goal": {"type": "string"},
    "acceptance": {"$ref": "#/$defs/strings"},
    "inputs": {"$ref": "#/$defs/strings"},
    "steps": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "depends_on": {"$ref": "#/$defs/strings"},
          "requires": {"$ref": "#/$defs/strings"},
          "produces": {"$ref": "#/$defs/strings"},
          "tools": {"$ref": "#/$defs/strings"},
          "paths": {"$ref": "#/$defs/strings"},
          "env": {"$ref": "#/$defs/strings"},
          "packages": {"$ref": "#/$defs/strings"},
          "reversible": {"type": "boolean"},
          "rollback": {"type": "boolean"},
          "backup": {"type": "boolean"},
          "timeout": {"type": "boolean"},
          "retries": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {"strings": {"type": "array", "items": {"type": "string"}}}
}
